# install.packages(c("tidyverse", "scales"))    # uncomment if needed
library(tidyverse)
library(scales)
source("inflation-data.R")
# Quick look
inflation_de
range(inflation_de$date)
unique(inflation_de$country)
bad_chart <-
ggplot(inflation_de, aes(x = date, y = hicp_yoy, color = country)) +
geom_line() +
labs(
title = "Figure 1",
x = "date",
y = "hicp_yoy"
)
bad_chart
# =============================================================================
# Workshop I — Worked solution
# Effective Visualization for Data Journalism — E1493, Simon Munzert
#
# This is *one* journalist's chart, not *the* journalist's chart.
# Headline finding chosen here:
#   "Germany's inflation peaked at 11.6% in October 2022 — well above
#   the ECB's 2% target — and took two years to come back down."
#
# Compare and contrast with your own version. Different headlines lead
# to different chart choices.
# =============================================================================
library(tidyverse)
library(scales)
source("inflation-data.R")
# ---- 1. Recode for journalism -----------------------------------------------
# Foreground = Germany. France/Italy = grey context. This is one of the
# most important habits in newsroom viz: decide what is *news* and what
# is *context*, then make that decision visible in colour.
inflation_de <- inflation_de |>
mutate(
role = if_else(country == "Germany", "news", "context"),
role = factor(role, levels = c("context", "news"))   # plot order
)
# ---- 2. A small, fixed palette ----------------------------------------------
# Single accent + grey. No legend needed if you label lines directly.
pal <- c(news = "#C2001A", context = "grey75")
# ---- 3. The chart -----------------------------------------------------------
# End-of-line label data — only Germany gets a "loud" label
labels_end <- inflation_de |>
group_by(country) |>
filter(date == max(date)) |>
ungroup()
good_chart <-
ggplot(inflation_de, aes(x = date, y = hicp_yoy, group = country, colour = role)) +
# ECB target line — free context
geom_hline(yintercept = 2, linetype = "dashed",
colour = "grey50", linewidth = 0.4) +
annotate("text", x = as.Date("2019-02-01"), y = 2.4,
label = "ECB target: 2%", hjust = 0, size = 3,
colour = "grey40", fontface = "italic") +
# The data
geom_line(linewidth = 0.9) +
# Direct labels at line ends — replaces the legend
geom_text(
data = labels_end,
aes(label = country),
hjust = -0.15, vjust = 0.5, size = 3.4, fontface = "bold",
show.legend = FALSE
) +
# Mark the peak
annotate("point", x = as.Date("2022-10-01"), y = 11.6,
colour = pal["news"], size = 2.4) +
annotate("text", x = as.Date("2022-10-01"), y = 12.2,
label = "Peak: 11.6%\nOctober 2022",
hjust = 0.5, vjust = 0, size = 3.1, lineheight = 0.95,
colour = pal["news"], fontface = "bold") +
# Event annotation — Russia invades Ukraine
annotate("segment",
x = as.Date("2022-02-24"), xend = as.Date("2022-02-24"),
y = 0, yend = 9,
colour = "grey40", linetype = "dotted") +
annotate("text", x = as.Date("2022-03-15"), y = 0.5,
label = "Russia invades\nUkraine",
hjust = 0, size = 3, lineheight = 0.95,
colour = "grey30") +
# Scales
scale_colour_manual(values = pal, guide = "none") +
scale_x_date(
breaks  = seq(as.Date("2019-01-01"), as.Date("2025-01-01"), by = "1 year"),
labels  = label_date_short(),
expand  = expansion(mult = c(0.02, 0.10))    # room for end labels
) +
scale_y_continuous(
breaks = seq(0, 12, 2),
labels = label_number(suffix = "%"),
limits = c(-2, 13)
) +
# The journalism: declarative title, source line in caption
labs(
title    = "Germany's inflation peaked at 11.6% in October 2022 — and took two years to fall back to target",
subtitle = "Year-on-year change in harmonised consumer prices (HICP), monthly, %",
caption  = "Source: Eurostat (prc_hicp_manr) | Chart: E1493 Data Journalism, Hertie School",
x = NULL, y = NULL
) +
# A theme worth reusing — minimal, high-contrast, mobile-friendly type sizes
theme_minimal(base_size = 12) +
theme(
plot.title.position    = "plot",
plot.caption.position  = "plot",
plot.title             = element_text(face = "bold", size = 13.5,
margin = margin(b = 4),
lineheight = 1.1),
plot.subtitle          = element_text(colour = "grey30", size = 11,
margin = margin(b = 16)),
plot.caption           = element_text(colour = "grey45", size = 8,
margin = margin(t = 12), hjust = 0),
panel.grid.minor       = element_blank(),
panel.grid.major.x     = element_blank(),
panel.grid.major.y     = element_line(colour = "grey92"),
axis.text              = element_text(colour = "grey30"),
plot.margin            = margin(14, 14, 10, 14)
)
good_chart
